{
  "name": "bedrock-skin-gltf",
  "version": "0.1.0",
  "description": "Convert Minecraft Bedrock skins (geometry + texture) to glTF in the same shape as the Persona API",
  "keywords": [
    "bedrock",
    "geometry",
    "glb",
    "gltf",
    "minecraft",
    "skin"
  ],
  "license": "MIT",
  "author": "RetoRuto9900K",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "fast-png": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "bumpp": "^12.3.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  }
}
